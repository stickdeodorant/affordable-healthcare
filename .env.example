APP_ENV=local
APP_DEBUG=true
ENABLE_ANALYTICS=false
SITE_NAME="Affordable Healthcare"
SITE_ADDRESS="8881 Ave, White Hall, OK 71612"
APP_DOMAIN=localhost
APP_URL=http://localhost
DEFAULT_STATE=FL

# Tracking / marketing
GTM_CONTAINERS=GTM-KPSJW24
GOOGLE_ADS_IDS=AW-XXXXXXXXX
GA_MEASUREMENT_IDS=UA-XXXXXXXXX-1,UA-XXXXXXXXX-1
# Multi-quote only: apply multi-quote default phone set on top of shared defaults
MQ_USE_PHONE_DEFAULTS=false
PIVOT_LPID=1003
CONVERSION_ID=809932216
CONVERSION_LABEL=2jwBCJKU5X8QuKuaggM

# Telephony overrides JSON merges with defaults
PHONE_OVERRIDES_JSON="{}"

# Database
DB_HOST=localhost
DB_NAME=afford_leads
DB_USER=afford_leads
DB_PASS=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE

# Optional dedicated DB for get-quotes/insert-confirmation.php
FORM_SUBMISSIONS_DB_HOST=localhost
FORM_SUBMISSIONS_DB_NAME=healthcareins_form_submissions
FORM_SUBMISSIONS_DB_USER=healthcareins_ajax_form
FORM_SUBMISSIONS_DB_PASS=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE

# Lead posting
BOBERDOO_URL=https://infinixmedia.leadportal.com/genericPostlead.php?
ENABLE_BOBERDOO_POST=true
BOBERDOO_API_URL=https://infinixmedia.leadportal.com/new_api/api.php?
BOBERDOO_API_KEY=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE

# Convoso API
CONVOSO_AUTH_TOKEN=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE
CONVOSO_LIST_ID=11817

# Twilio - Phone Validation
TWILIO_ACCOUNT_SID=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE
TWILIO_AUTH_TOKEN=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE

# Phone validation API key (used by get-quotes/validation-phone.php)
PHONE_VALIDATION_ACCESS_KEY=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE

# Mail sending - Mailtrap
MAILTRAP_TOKEN=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE
MAILTRAP_FROM_EMAIL=no-reply@affordable-healthcare.com
MAILTRAP_FROM_NAME="Affordable Healthcare"
MAILTRAP_RECIPIENT=kelliott@infinixmedia.com
ENABLE_MAIL=true

# TrustedForm
TRUSTEDFORM_API_KEY=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE

# Admin credentials (use strong password in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REQUIRED_SET_IN_DEPLOYMENT_SECRET_STORE
